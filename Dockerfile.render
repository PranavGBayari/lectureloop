# Backend image for a hosted deploy (Render, Fly.io). Build context is the repo root so the demo
# lecture ships inside the image; local development uses backend/Dockerfile via docker compose.
FROM python:3.12-slim
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv
WORKDIR /srv/backend
COPY backend/pyproject.toml backend/uv.lock ./
RUN uv sync --frozen --no-dev
COPY backend/app ./app
COPY backend/tests/redteam.jsonl ./tests/redteam.jsonl
COPY demo/lecture_transcript.json /srv/demo/lecture_transcript.json
ENV DEMO_TRANSCRIPT=/srv/demo/lecture_transcript.json
EXPOSE 8000
# One worker: lecture state (open concept, per-student queues) lives in process memory.
CMD ["sh", "-c", "uv run --no-dev uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000} --workers 1"]
