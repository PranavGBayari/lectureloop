# Claude API key (https://console.anthropic.com). Needed unless LLM_PROVIDER=fake.
ANTHROPIC_API_KEY=
# ElevenLabs key (https://elevenlabs.io) for live lecture transcription with Scribe v2 Realtime.
# Empty = off: "Go live" uses the browser's Web Speech API (Chrome or Edge) instead.
ELEVENLABS_API_KEY=
# Empty = in-memory store (no setup). Set to a MongoDB Atlas URI to persist sessions.
MONGODB_URI=
MODEL_SMART=claude-sonnet-5-5
MODEL_FAST=claude-haiku-5-5
# true | false | cached
DEMO_MODE=true
# anthropic = real Claude. fake = scripted offline model that knows the demo lecture (no key, no network).
LLM_PROVIDER=anthropic
# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:3000
# Where the browser reaches the backend
# Leave unset on Vercel (a production build then calls the backend service at /api on the same domain)
# and for `npm run dev` (calls http://localhost:8000). Set it to point the browser somewhere else,
# for example the Render URL if the backend is hosted there.
NEXT_PUBLIC_API_URL=
