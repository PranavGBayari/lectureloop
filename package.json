{
  "name": "lectureloop",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "cd backend && uv run uvicorn app.main:app --reload --port 8000",
    "dev:web": "cd frontend && npm run dev",
    "setup": "cd backend && uv sync && cd ../frontend && npm install",
    "test": "cd backend && uv run pytest -q",
    "gen:types": "cd frontend && npm run gen:types"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
